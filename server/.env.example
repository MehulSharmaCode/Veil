# Copy to server/.env (gitignored). API keys live ONLY there — never in the extension, never committed.
# Planner provider: groq | gemini (rollback = change this one line)
VEIL_PROVIDER=groq
# Groq key (https://console.groq.com/keys), used when VEIL_PROVIDER=groq
GROQ_API_KEY=
# Gemini key (https://aistudio.google.com/apikey), used when VEIL_PROVIDER=gemini
GEMINI_API_KEY=
# Planner model. Leave unset for the provider's default (groq: openai/gpt-oss-20b, gemini: gemini-3.8-flash).
# VEIL_MODEL=
# Reasoning effort (Groq reasoning_effort / Gemini thinking_level): low | medium | high
VEIL_EFFORT=medium

# Dev only: append every received /plan payload to server/logs/received_payloads.jsonl (for scripts/check_leaks.py)
VEIL_DEV_LOG_PAYLOADS=1

# Dashboard origin(s) allowed by CORS (comma-separated)
VEIL_DASHBOARD_ORIGIN=http://localhost:8090,http://127.0.0.1:8090
